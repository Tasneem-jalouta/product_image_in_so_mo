<odoo>
  <record id="view_mrp_production_form_with_image" model="ir.ui.view">
    <field name="name">mrp.production.form.with.image</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='user_id']" position="after">
        <field name="product_image" widget="image" options="{'size': [80, 80]}" readonly="1"/>
      </xpath>
    </field>
  </record>
</odoo>
